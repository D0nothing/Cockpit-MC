{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["vite/client"],
    "isolatedModules": true
  },
  "include": [
    "src",
    "lib",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
