{
  "name": "software-factory",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev -w @software-factory/api\" \"npm:dev -w @software-factory/web\"",
    "build": "npm run build -w @software-factory/api && npm run build -w @software-factory/web",
    "test": "npm run test -w @software-factory/contracts && npm run test -w @software-factory/api",
    "test:unit": "npm run test -w @software-factory/contracts && npm run test:unit -w @software-factory/api",
    "test:e2e": "npm run test:e2e -w @software-factory/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "db:generate": "npm run prisma:generate -w @software-factory/api",
    "db:migrate": "npm run prisma:migrate -w @software-factory/api",
    "db:seed": "npm run prisma:seed -w @software-factory/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
